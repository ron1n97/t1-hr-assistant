# T1 HR Assistant Environment Configuration
# Скопируйте этот файл в .env и заполните ваши значения

# =============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ
# =============================================================================

# Обязательные переменные
SCIBOX_API_KEY=sk-pI9UrN6mhNCIQ6wCZ3m0RA

# =============================================================================
# WHISPER SERVER (транскрипция аудио)
# =============================================================================

# URL Whisper сервера
WILLOW_SERVER_URL=http://whisper-server:9000
# Для локальной разработки с внешним Whisper:
# WILLOW_SERVER_URL=http://localhost:8001

# API ключ (опционально)
WILLOW_API_KEY=

# Порт Willow сервера
WILLOW_PORT=8001

# Настройки Whisper модели
WILLOW_WHISPER_MODEL=whisper-large-v3
# Альтернативы: whisper-base, whisper-small, whisper-medium, whisper-large-v2

# Язык транскрипции
WILLOW_WHISPER_LANGUAGE=ru

# Тип задачи (transcribe или translate)
WILLOW_WHISPER_TASK=transcribe

# Устройство (cpu или cuda)
WILLOW_DEVICE=cpu
# Для GPU: WILLOW_DEVICE=cuda

# =============================================================================
# РЕЖИМЫ РАБОТЫ
# =============================================================================

# Режим работы (development или production)
ENVIRONMENT=development

# Монтирование кода (z для разработки, ro для продакшена)
MOUNT_CODE=z
# Для продакшена: MOUNT_CODE=ro

# =============================================================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# =============================================================================

# Python настройки
PYTHONPATH=/app
UV_SYSTEM_PYTHON=1

# Dockerfile (Dockerfile или Dockerfile.pip)
DOCKERFILE=Dockerfile

# Для разработки (опционально)
# DEBUG=true
# LOG_LEVEL=info
